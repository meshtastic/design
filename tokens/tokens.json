{
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#2C2D3C", "$description": "charcoal — primary foreground (= Neutral 800)" },
      "accent":  { "$value": "#67EA94", "$description": "chirp green (= Green 500) — fills / dark-mode primary ONLY, never text on light (fails AA); use green.700/600 for green text" }
    },
    "neutral": {
      "50":  { "$value": "#F5F6FA" }, "100": { "$value": "#ECEDF3" }, "200": { "$value": "#D5D6E0" },
      "300": { "$value": "#B8BAC8" }, "400": { "$value": "#9496A6" }, "500": { "$value": "#6E7082" },
      "600": { "$value": "#555668" }, "700": { "$value": "#3D3E50" }, "800": { "$value": "#2C2D3C" },
      "900": { "$value": "#1A1B26" }, "950": { "$value": "#0F1017", "$description": "OLED background" }
    },
    "neutral-variant": {
      "50":  { "$value": "#F6F7FC" }, "100": { "$value": "#EDEEF6" }, "200": { "$value": "#DADBE7" },
      "300": { "$value": "#BDBFCF" }, "400": { "$value": "#9698B0" }, "500": { "$value": "#767892" },
      "600": { "$value": "#5C5E78" }, "700": { "$value": "#444660" }, "800": { "$value": "#303245" },
      "900": { "$value": "#1D1E2B" }
    },
    "green": {
      "50":  { "$value": "#F0FEF5" }, "100": { "$value": "#E5FCEE" }, "200": { "$value": "#CCFADD" },
      "300": { "$value": "#B5F5CE" }, "400": { "$value": "#8FF0B2" }, "500": { "$value": "#67EA94" },
      "600": { "$value": "#3FB86D", "$description": "green text on light / success" },
      "700": { "$value": "#2D8F52", "$description": "theme primary (light)" },
      "800": { "$value": "#005C2E" }, "900": { "$value": "#003D1A" }, "950": { "$value": "#002E13" }
    },
    "blue": {
      "50":  { "$value": "#E8EAF6" }, "100": { "$value": "#E0E3F8" }, "200": { "$value": "#D0D8F5" },
      "300": { "$value": "#B0BFF0" }, "400": { "$value": "#9BA8E0", "$description": "link color" },
      "500": { "$value": "#7B8AD0" }, "600": { "$value": "#5C6BC0" },
      "700": { "$value": "#2855A8", "$description": "theme tertiary (light)" },
      "800": { "$value": "#1A3F8C" }, "900": { "$value": "#002366" }, "950": { "$value": "#001849" }
    },
    "error": {
      "100": { "$value": "#FDEAEA" }, "200": { "$value": "#FFDAD6" }, "300": { "$value": "#FFB4AB" },
      "400": { "$value": "#FF897D" }, "500": { "$value": "#E05252" },
      "600": { "$value": "#BA1A1A", "$description": "error text (WCAG-safe on white)" },
      "700": { "$value": "#93000A" }, "800": { "$value": "#690005" }, "900": { "$value": "#410002" }
    },
    "semantic": {
      "link":          { "$value": "#9BA8E0" }, "link-light":    { "$value": "#E0E3F8" },
      "info":          { "$value": "#5C6BC0" }, "info-light":    { "$value": "#E8EAF6" },
      "warning":       { "$value": "#E8A33E" }, "warning-light": { "$value": "#FFF3E0" },
      "error":         { "$value": "#E05252" }, "error-light":   { "$value": "#FDEAEA" },
      "success":       { "$value": "#3FB86D" }, "success-light": { "$value": "#E5FCEE" }
    }
  }
}
